---
import Layout from '../layouts/Layout.astro';
import SheetMusicViewer from '../components/SheetMusicViewer.astro';

const description = "JamBuddy is the offline Android practice app with real-time chord detection, ABC sheet music that scales to your screen, tab for guitar/mandolin/uke, MIDI playback, looping audio player, tuner, and metronome. No accounts, no ads, no subscriptions.";
---

<Layout title="JamBuddy – Sheet Music & Practice Tools for Musicians" description={description} fullWidth contentClass="content-overlay w-full max-w-none" analyticsName="Sheet Music (Home)">
  <SheetMusicViewer />
</Layout>
