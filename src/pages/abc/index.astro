---
import Layout from '../../layouts/Layout.astro';
import SheetMusicViewer from '../../components/SheetMusicViewer.astro';
import { ABC_TITLE_MAP } from '../../lib/abcCollections';

const pageTitle = ABC_TITLE_MAP['old-time-jam-tunes'] ?? 'ABC Collection';
---

<Layout title={`${pageTitle} – ABC Collection`} description={`View and edit the ${pageTitle} ABC collection in your browser.`} fullWidth contentClass="content-overlay w-full max-w-none" analyticsName={`${pageTitle} ABC Collection`}>
  <SheetMusicViewer />
</Layout>
