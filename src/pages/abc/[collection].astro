---
import Layout from '../../layouts/Layout.astro';
import SheetMusicViewer from '../../components/SheetMusicViewer.astro';
import { ABC_COLLECTIONS, ABC_TITLE_MAP, loadCollection } from '../../lib/abcCollections';

const { collection } = Astro.params;

export async function getStaticPaths() {
  return ABC_COLLECTIONS.map(({ slug }) => ({ params: { collection: slug } }));
}

const slug = collection! as string;
const pageTitle = ABC_TITLE_MAP[slug] ?? 'ABC Collection';
const collectionExists = !!loadCollection(slug).content;
---

<Layout title={`${pageTitle} – ABC Collection`} description={`View and edit the ${pageTitle} ABC collection in your browser.`} fullWidth contentClass="content-overlay w-full max-w-none" analyticsName={`${pageTitle} ABC Collection`}>
  {collectionExists ? (
    <SheetMusicViewer slug={slug} />
  ) : (
    <section class="w-full px-2 sm:px-4 lg:px-6 xl:px-10 2xl:px-16 py-3">
      <h1 class="mb-4 text-3xl font-bold text-white">{pageTitle}</h1>
      <div class="p-4 rounded bg-red-900/40 border border-red-800 text-red-200">
        <p class="font-semibold">Failed to load the ABC source file.</p>
        <p class="mt-2 text-sm">
          Ensure the collection .abc files are present in <code>/public/collections</code> when building the website.
        </p>
      </div>
    </section>
  )}
</Layout>
