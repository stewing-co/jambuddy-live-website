---
import Layout from '../../../layouts/Layout.astro';
import CollectionPicker from '../../../components/CollectionPicker.astro';
import LibrarySearch from '../../../components/LibrarySearch.astro';
import { loadLibrary, originUrl, viewerHref, type LibraryGenre } from '../../../lib/abcLibrary';
import { loadGenreTuneLists } from '../../../lib/genreTunes';

export async function getStaticPaths() {
  const genres = await loadLibrary();
  return genres.map((genre) => ({ params: { genre: genre.genre }, props: { genre } }));
}

const { genre } = Astro.props as { genre: LibraryGenre };
const allTunes = (await loadGenreTuneLists()).get(genre.genre);
// Some collections hold thousands of single-tune files; search covers those, so list only the largest.
const FILES_SHOWN = 100;
const fileLabel = (path: string) => (path.split('/').pop() ?? path).replace(/\.abc$/i, '');
---

<Layout title={`${genre.name} tunes - JamBuddy ABC Library`} description={`Search and browse ${genre.tunes.toLocaleString('en-US')} ${genre.name} tunes in ABC notation.`}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 text-white">
    <div class="flex flex-wrap items-center gap-3 mb-2">
      <h1 class="text-4xl font-bold">{genre.name}</h1>
      <CollectionPicker />
    </div>
    <p class="text-gray-300 mb-6">
      {genre.tunes.toLocaleString('en-US')} versions of {(allTunes?.tunes.length ?? genre.tunes).toLocaleString('en-US')} tunes from {genre.sources.length} collections.
      {allTunes && <a href={`/abc/tunes/${genre.genre}`} class="ml-1 text-blue-300 underline hover:text-blue-200">Browse every tune in the sheet music viewer</a>}
    </p>

    <LibrarySearch label="Search tunes" genre={genre.genre} />

    <h2 class="text-2xl font-bold mb-4">Collections</h2>
    <div class="space-y-3">
      {genre.sources.map((source) => (
        <details class="group rounded-lg border border-gray-700 bg-gray-800">
          <summary class="flex cursor-pointer flex-wrap items-baseline justify-between gap-2 px-4 py-3">
            <span class="font-semibold">{source.name}</span>
            <span class="text-sm text-gray-400">{source.tunes.toLocaleString('en-US')} tunes · {source.files.length} files</span>
          </summary>
          <div class="border-t border-gray-700 px-4 py-3">
            {originUrl(source.origin) && (
              <p class="mb-2 text-sm text-gray-400">Source: <a class="underline hover:text-gray-200" href={originUrl(source.origin)} target="_blank" rel="noopener">{originUrl(source.origin)}</a></p>
            )}
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 text-sm">
              {source.files.slice(0, FILES_SHOWN).map((file) => (
                <li class="min-w-0 truncate">
                  <a class="text-blue-300 hover:text-blue-200" href={viewerHref(file.path, undefined, genre.genre)}>{file.tunes > 1 ? fileLabel(file.path) : file.first}</a>
                  <span class="text-gray-500"> · {file.tunes === 1 ? '1 tune' : `${file.tunes} tunes`}</span>
                </li>
              ))}
            </ul>
            {source.files.length > FILES_SHOWN && (
              <p class="mt-2 text-xs text-gray-500">Showing the {FILES_SHOWN} largest of {source.files.length} files. Use the search above to find any tune.</p>
            )}
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>
