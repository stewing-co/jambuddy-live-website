---
import CollectionPicker from './CollectionPicker.astro';
import { ABC_COLLECTIONS, ABC_FILENAME_MAP, ABC_TITLE_MAP } from '../lib/abcCollections';
import { collectionHref } from '../lib/abcLibrary';

interface Props {
  /** Identifies the collection for remembered tune selection. */
  slug?: string;
  title?: string;
  /** ABC file to load; the library viewer sets it from the page URL instead. */
  collectionUrl?: string;
  /** Href of the collection picker option to show as selected. */
  selected?: string;
  /** All-tunes collection: a genre's tune list (src/lib/genreTunes.ts) to show instead of an ABC file. */
  tuneList?: string;
}

const {
  slug = 'old-time-jam-tunes',
  title,
  collectionUrl = `/collections/${ABC_FILENAME_MAP[slug]}`,
  selected = slug === 'old-time-jam-tunes' ? '/abc' : `/abc/${slug}`,
  tuneList
} = Astro.props;
const pageTitle = title ?? ABC_TITLE_MAP[slug] ?? 'ABC Collection';
// On phones the collection dropdown names a JamBuddy collection, so its title would repeat it.
const pickerNamesPage = ABC_COLLECTIONS.some((c) => collectionHref(c.slug) === selected);
---

<section data-abc-collection={slug} class="w-full px-2 sm:px-4 lg:px-6 xl:px-10 2xl:px-16 py-3 h-[calc(100dvh-5rem)] overflow-hidden flex flex-col">
  <div class="flex items-center gap-3 mb-3 shrink-0 sm:mb-4">
    <h1 id="abcCollectionTitle" class={`min-w-0 truncate font-bold text-white ${pickerNamesPage ? 'hidden sm:block sm:text-3xl' : 'text-xl sm:text-3xl'}`}>{pageTitle}</h1>
    <CollectionPicker selected={selected} />
  </div>

  <div class="flex flex-col gap-4 flex-1 min-h-0">
        <div class="flex flex-col space-y-3 flex-1 min-h-0">
          <div class="rounded border border-gray-700 bg-gray-800 p-3" data-ignore-print>
            <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-3">
              <div class="min-w-0 flex-1 space-y-2">
                <div class="flex flex-col gap-2 sm:flex-row">
                  <select id="tuneSelect" data-collection={slug} aria-label="Choose tune" class="w-full min-w-0 rounded border border-gray-700 bg-black p-2 text-sm text-gray-200 sm:flex-1"></select>
                  <div class="flex min-w-0 items-center gap-2 sm:flex-1">
                    <input
                      id="tuneSearch"
                      type="search"
                      inputmode="search"
                      placeholder="Search tunes in every collection"
                      aria-label="Search tunes"
                      aria-controls="tuneSearchResults"
                      autocomplete="off"
                      class="w-full min-w-0 rounded border border-gray-700 bg-black p-2 text-sm text-gray-200 placeholder:text-gray-500"
                    />
                    <button
                      id="tuneFiltersToggle"
                      type="button"
                      aria-expanded="false"
                      aria-controls="tuneFilters"
                      title="Filter by type, key and more"
                      class="hidden shrink-0 items-center gap-1 rounded border border-gray-700 bg-black px-2 py-2 text-xs font-semibold text-gray-300 hover:border-gray-400 hover:text-white aria-expanded:border-blue-400 aria-expanded:text-white"
                    >
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h18l-7 8v6l-4 2v-8z"></path></svg>
                      <span>Filters</span><span id="tuneFilterCount" class="text-blue-300"></span>
                    </button>
                  </div>
                </div>
                <label id="versionPicker" class="hidden flex-wrap items-center gap-2 text-xs text-gray-400">
                  <span class="font-semibold uppercase tracking-wide">Version</span>
                  <select id="versionSelect" class="min-w-0 flex-1 rounded border border-gray-700 bg-black p-2 text-sm text-gray-200"></select>
                </label>
                <div id="tuneSearchPanel" class="hidden space-y-1" data-ignore-print>
                  <p id="tuneSearchStatus" class="text-xs text-gray-400" aria-live="polite"></p>
                  <ul id="tuneSearchResults" class="max-h-36 overflow-auto sm:max-h-48 rounded border border-gray-700 bg-black/60 divide-y divide-gray-800 text-sm"></ul>
                </div>
                <div id="tuneFilters" class="hidden rounded border border-gray-700 bg-gray-900/70 p-2 text-gray-200" data-ignore-print>
                  <div class="space-y-2">
                    <div id="abcHeaderFilters" class="grid grid-cols-2 gap-2 xl:grid-cols-3"></div>
                    <button
                      id="resetTuneFilters"
                      type="button"
                      class="rounded border border-gray-600 px-2 py-1 text-xs text-gray-300 hover:border-gray-400 hover:text-white"
                      hidden
                    >
                      Reset filters
                    </button>
                  </div>
                </div>
                <p id="abcLoadStatus" class="text-xs text-blue-300" aria-live="polite">Loading collection...</p>
              </div>
              <div id="tuneQuickControls" class="flex items-center gap-2 flex-wrap">
                <button id="playToggle" class="rounded bg-green-600 px-2.5 py-2 text-white hover:bg-green-500 flex items-center gap-1.5" title="Play" aria-label="Play" type="button">
                  <span id="playToggleIcon" class="flex items-center"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg></span>
                  <span id="playToggleLabel" class="text-xs font-semibold">Play</span>
                </button>
                <button id="repeatToggle" class="rounded bg-gray-700 px-2.5 py-2 text-white hover:bg-gray-600 flex items-center gap-1.5" aria-pressed="false" aria-label="Repeat full tune off" title="Repeat full tune off" type="button">
                  <span id="repeatToggleIcon" class="flex items-center"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg></span>
                  <span class="text-xs font-semibold">Loop</span>
                </button>
                <button data-print-trigger class="rounded bg-gray-700 px-2.5 py-2 text-white hover:bg-gray-600 flex items-center gap-1.5" title="Print tune" aria-label="Print tune" type="button">
                  <span aria-hidden="true">🖨️</span>
                  <span class="text-xs font-semibold">Print</span>
                </button>
                <button id="expandToggle" class="rounded bg-gray-700 px-2.5 py-2 text-white hover:bg-gray-600 flex items-center gap-1.5" title="Expand tune to full screen" aria-label="Expand tune to full screen" aria-pressed="false" type="button">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="5 9 2 12 5 15"></polyline>
                    <polyline points="9 5 12 2 15 5"></polyline>
                    <polyline points="15 19 12 22 9 19"></polyline>
                    <polyline points="19 9 22 12 19 15"></polyline>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <line x1="12" y1="2" x2="12" y2="22"></line>
                  </svg>
                  <span class="text-xs font-semibold">Expand</span>
                </button>
              </div>
            </div>
          </div>

          <details class="group rounded border border-gray-700 bg-gray-900/70 px-4 py-3 text-gray-200" data-ignore-print>
            <summary class="flex cursor-pointer items-center justify-between gap-3 text-sm font-semibold uppercase tracking-wide text-gray-300 transition group-open:text-white">
              Playback &amp; Controls
              <span class="text-xs font-medium text-gray-400 group-open:text-blue-300">Toggle</span>
            </summary>
            <div class="mt-4 space-y-3">
              <div class="rounded border border-gray-700 bg-gray-800 p-3">
                <div class="flex flex-wrap items-center gap-3">
                  <div class="flex items-center gap-2">
                    <button id="transposeDown" class="rounded bg-gray-700 px-2 py-1 text-white" title="Transpose down">&#9837;</button>
                    <span id="currentKeyLabel" class="min-w-[2ch] text-center font-semibold text-gray-100">K?</span>
                    <button id="transposeUp" class="rounded bg-gray-700 px-2 py-1 text-white" title="Transpose up">&#9839;</button>
                    <label class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-300">
                      Clef
                      <select id="clefSelect" class="rounded border border-gray-700 bg-gray-800 px-2 py-1 text-sm text-gray-100">
                        <option value="auto">Original</option>
                        <option value="treble">Treble</option>
                        <option value="alto">Alto</option>
                        <option value="tenor">Tenor</option>
                        <option value="bass">Bass</option>
                      </select>
                    </label>
                    <label class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-gray-300">
                      Octave
                      <select id="octaveSelect" class="rounded border border-gray-700 bg-gray-800 px-2 py-1 text-sm text-gray-100">
                        <option value="2">+2</option>
                        <option value="1">+1</option>
                        <option value="0" selected>0</option>
                        <option value="-1">-1</option>
                        <option value="-2">-2</option>
                      </select>
                    </label>
                  </div>
                  <div class="flex flex-wrap items-center gap-3">
                    <div class="flex items-center gap-2">
                      <input id="tempoSlider" type="range" min="40" max="220" value="120" class="w-20" />
                      <span id="tempoLabel" class="text-sm text-gray-300">120 BPM</span>
                    </div>
                    <label class="flex items-center gap-2 text-sm text-gray-300">
                      Render height
                      <input id="renderScale" type="range" min="20" max="100" value="100" class="w-28" />
                      <span id="renderScaleLabel" class="text-sm text-gray-300">100%</span>
                    </label>
                  </div>
                  <div class="flex flex-wrap items-center gap-2">
                    <button
                      id="playbackModeToggle"
                      class="rounded bg-blue-600 px-3 py-1 text-white hover:bg-blue-500"
                      title="Playback Mode: Chords + Melody"
                      type="button"
                    >
                      🎵 Mixed
                    </button>
                    <button
                      id="highlightToggle"
                      class="rounded border border-amber-500 px-3 py-1 text-amber-400 hover:bg-amber-500 hover:text-black"
                      aria-pressed="false"
                      type="button"
                    >
                      Highlight notes: Off
                    </button>
                    <div class="flex items-center gap-2">
                      <button
                        id="metronomeToggle"
                        class="rounded border border-blue-400 px-3 py-1 text-blue-200 transition hover:bg-blue-500/20 hover:text-white"
                        aria-pressed="false"
                        type="button"
                      >
                        Metronome: Off
                      </button>
                      <button
                        id="leadInToggle"
                        class="rounded border border-indigo-400 px-3 py-1 text-indigo-200 transition hover:bg-indigo-500/20 hover:text-white"
                        aria-pressed="true"
                        type="button"
                      >
                        Lead-in: On
                      </button>
                      <span id="metronomeDisplay" class="min-w-[4ch] text-xs font-semibold text-blue-200 opacity-60"></span>
                    </div>
                    <label class="flex items-center gap-2 text-sm text-gray-300">
                      Tab layer
                      <select id="layerSelect" class="rounded border border-gray-700 bg-black p-2 text-sm text-gray-200">
                        <option value="none">None (Staff only)</option>
                        <option value="guitar">Guitar</option>
                        <option value="mandolin">Mandolin</option>
                        <option value="ukulele">Ukulele</option>
                        <option value="baritone">Baritone Ukulele</option>
                        <option value="banjo">Banjo</option>
                        <option value="viola">Viola</option>
                        <option value="cello">Cello</option>
                        <option value="bass">Bass</option>
                      </select>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </details>

          <div class="flex-1 min-h-0 overflow-auto rounded border border-gray-800 bg-gray-900 p-3 abc-print-target">
            <div id="paper" class="h-full"></div>
          </div>
        </div>

        <div class="flex flex-col space-y-2 shrink-0" data-ignore-print>
          <div class="flex justify-end gap-2 flex-wrap">
            <div class="flex gap-2">
              <button id="exportTuneAbc" class="whitespace-nowrap px-2 py-1 text-sm bg-gray-700 text-white rounded sm:px-3 sm:text-base" title="Export selected tune as .abc">Tune .abc</button>
              <button id="exportFullAbc" class="whitespace-nowrap px-2 py-1 text-sm bg-gray-700 text-white rounded sm:px-3 sm:text-base" title="Export full collection as .abc">Full .abc</button>
              <button id="printSheet" data-print-trigger type="button" class="whitespace-nowrap px-2 py-1 text-sm bg-gray-700 text-white rounded sm:px-3 sm:text-base" title="Print the rendered sheet music">Print</button>
              <button id="exportPng" class="whitespace-nowrap px-2 py-1 text-sm bg-gray-700 text-white rounded sm:px-3 sm:text-base" title="Export rendered sheet as .png">PNG</button>
              <button id="exportMidi" class="whitespace-nowrap px-2 py-1 text-sm bg-gray-700 text-white rounded sm:px-3 sm:text-base" title="Export MIDI">MIDI</button>
            </div>
          </div>
          <details class="group rounded border border-gray-700 bg-gray-900/70" data-ignore-print>
            <summary class="flex cursor-pointer items-center justify-between gap-3 px-3 py-2 text-sm font-semibold uppercase tracking-wide text-gray-300 transition group-open:text-white">
              Edit ABC source
              <span class="text-xs font-medium text-gray-400 group-open:text-blue-300">Toggle</span>
            </summary>
            <div class="p-2">
              <textarea id="abcInput" data-collection-src={collectionUrl} data-tune-list={tuneList} class="w-full h-48 lg:h-56 min-h-[8rem] p-3 font-mono text-sm rounded bg-black text-gray-200 border border-gray-700 resize-y"></textarea>
            </div>
          </details>
        </div>
      </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/abcjs@6.4.4/dist/abcjs-basic-min.js" defer></script>
<style>
  #paper .abc-current-note {
    fill: #f59e0b !important;
    stroke: #f59e0b !important;
    opacity: 0.95;
  }
  #paper .abc-current-note path,
  #paper .abc-current-note polygon,
  #paper .abc-current-note polyline,
  #paper .abc-current-note use,
  #paper .abc-current-note ellipse,
  #paper .abc-current-note circle,
  #paper .abc-current-note rect {
    fill: #f59e0b !important;
    stroke: #f59e0b !important;
  }
  #paper .abcjs-note_selected,
  #paper .abcjs-note_selected * {
    fill: #f59e0b !important;
    stroke: #f59e0b !important;
  }
  @media print {
    body.abc-printing * {
      display: none !important;
    }
    body.abc-printing [data-ignore-print] {
      display: none !important;
    }
    body.abc-printing .abc-print-target,
    body.abc-printing .abc-print-target * {
      display: block !important;
      visibility: visible !important;
    }
    body.abc-printing .abc-print-target {
      position: static !important;
      margin: 0 auto !important;
      padding: 0 !important;
      box-shadow: none !important;
      border: none !important;
      background: transparent !important;
    }
    body.abc-printing #paper {
      margin: 0 auto;
    }
  }
</style>
<script src="/abc/library-search.js" defer></script>
  <script src="/abc/viewer.js" defer></script>
<script src="/abc/init-viewer.js" defer></script>
