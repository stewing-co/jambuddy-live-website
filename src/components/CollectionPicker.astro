---
// Collection dropdown shared by the sheet music pages and the ABC tune library: JamBuddy's
// collections. Tunes from the tune library are found through the viewer's search.
import { ABC_COLLECTIONS } from '../lib/abcCollections';
import { collectionHref } from '../lib/abcLibrary';

interface Props {
  /** Href of the current collection, e.g. "/abc/mandozine". */
  selected?: string;
}

const { selected: requested = '' } = Astro.props;
// The Old-Time collection is served at both /abc and /abc/old-time-jam-tunes.
const selected = requested === '/abc/old-time-jam-tunes' ? '/abc' : requested;
const current = ABC_COLLECTIONS.some((c) => collectionHref(c.slug) === selected);
---

<label class="ml-auto flex min-w-0 flex-1 items-center justify-end gap-2 text-sm text-gray-300 sm:flex-none">
  <span class="sr-only sm:not-sr-only text-xs font-semibold uppercase tracking-wide text-gray-400">Collection</span>
  <select
    id="collectionPicker"
    aria-label="Choose collection"
    class="w-full min-w-0 truncate rounded border border-gray-700 bg-black p-2 text-sm text-gray-200 sm:w-auto sm:max-w-xs"
    onchange="if(this.value)window.location.href=this.value"
  >
    {!current && <option value="" selected>Choose a collection…</option>}
    {ABC_COLLECTIONS.map((c) => (
      <option value={collectionHref(c.slug)} selected={collectionHref(c.slug) === selected}>{c.title}</option>
    ))}
  </select>
</label>
